generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Miembros de la Junta Directiva del Patronato (institución, representante, cargo)
model JuntaDirectivo {
  id            Int      @id @default(autoincrement())
  institucion   String
  representante String
  cargo         String
  logoUrl       String?
  fotoUrl       String?
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Personal técnico y administrativo del parque
model PersonalTecnico {
  id        Int      @id @default(autoincrement())
  nombre    String
  cargo     String
  fotoUrl   String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Instalaciones y áreas del parque (Instalaciones y servicios)
model Instalacion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  cantidad    Int?
  fotoUrl     String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Programas y servicios activos (Programas y proyectos)
model Programa {
  id          Int      @id @default(autoincrement())
  nombre      String
  categoria   String
  descripcion String
  fotoUrl     String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Agenda de eventos (Actividades) — sin datos reales todavía, pendientes del calendario 2026
model Actividad {
  id          Int       @id @default(autoincrement())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime?
  lugar       String?
  imagenUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Puntos señalados en el mapa del parque, con coordenadas geográficas reales
// para ubicarlos sobre el mapa interactivo.
model PuntoMapa {
  id        Int      @id @default(autoincrement())
  nombre    String
  zona      String?
  lat       Float    @default(19.4667)
  lng       Float    @default(-70.6953)
  fotoUrl   String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog: artículos y noticias. Se ordenan por fecha, no por posición manual.
model Publicacion {
  id        Int      @id @default(autoincrement())
  titulo    String
  tipo      String   @default("noticia") // noticia | articulo
  resumen   String?
  contenido String
  imagenUrl String?
  fecha     DateTime @default(now())
  // Cuando está marcada, se anuncia en la barra superior y en la ventana
  // emergente de la página de inicio.
  destacada Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Galería multimedia — pendiente de fotos reales (carpeta FOTOS Y AUDIOVISUALES)
model GaleriaItem {
  id        Int      @id @default(autoincrement())
  titulo    String?
  url       String
  tipo      String   @default("imagen") // imagen | video
  categoria String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Aliados institucionales (logos de las instituciones de la Junta Directiva)
model Aliado {
  id        Int      @id @default(autoincrement())
  nombre    String
  logoUrl   String?
  sitioWeb  String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos de Transparencia (estados financieros auditados / sin auditar)
model DocumentoFinanciero {
  id        Int      @id @default(autoincrement())
  titulo    String
  tipo      String // "auditado" | "sin_auditar"
  url       String
  fecha     DateTime?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mensajes del formulario de Contacto y ubicación
// Sugerencias y comunicaciones que envian los visitantes desde el sitio.
// Van aparte de los mensajes de contacto porque se atienden distinto: el
// contacto suele ser una consulta puntual y esto es retroalimentacion, que el
// Parque revisa en conjunto.
// Personas con acceso al panel. Antes era una sola credencial compartida por
// todo el equipo, asi que no quedaba registro de quien cambiaba que.
model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String
  // Con lo que inicia sesion. Se guarda en minusculas para que no dependa de
  // como lo escriban al entrar.
  usuario      String    @unique
  email        String?
  passwordHash String
  // admin | editor | comunicaciones
  rol          String    @default("editor")
  // Se desactiva en vez de borrar cuando alguien deja el equipo: asi se
  // conserva el registro de lo que hizo.
  activo       Boolean   @default(true)
  ultimoAcceso DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Sugerencia {
  id           Int      @id @default(autoincrement())
  // sugerencia | felicitacion | queja | otro
  tipo         String   @default("sugerencia")
  nombre       String
  email        String
  telefono     String?
  mensaje      String
  leida        Boolean  @default(false)
  emailEnviado Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String
  telefono     String?
  asunto       String?
  mensaje      String
  emailEnviado Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Contenido de las secciones que antes estaba escrito dentro del código.
// Cada modelo corresponde a una lista editable desde el panel.
// ─────────────────────────────────────────────────────────────────────────────

// Hitos de la historia del parque (Sobre Nosotros → Historia)
model Hito {
  id        Int      @id @default(autoincrement())
  fecha     String
  titulo    String
  texto     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Normas de convivencia (Sobre Nosotros → Reglamento)
// Valores institucionales (Mision, Vision y Valores). La mision y la vision
// son textos sueltos; cada valor es un registro con su icono.
model Valor {
  id        Int      @id @default(autoincrement())
  icono     String   @default("ti-heart-handshake")
  titulo    String
  texto     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Norma {
  id        Int      @id @default(autoincrement())
  icono     String   @default("ti-info-circle")
  titulo    String
  texto     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pasos para reservar un espacio (Reserva)
model PasoReserva {
  id        Int      @id @default(autoincrement())
  icono     String   @default("ti-circle-check")
  titulo    String
  texto     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Formas de apoyar al parque (Apóyanos)
model FormaApoyo {
  id        Int      @id @default(autoincrement())
  icono     String   @default("ti-heart-handshake")
  etiqueta  String
  titulo    String
  texto     String
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cifras destacadas de la página de inicio
model Cifra {
  id          Int      @id @default(autoincrement())
  numero      String
  descripcion String
  imagenUrl   String?
  etiqueta    String?
  enlaceTexto String?
  enlaceUrl   String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Textos sueltos del sitio, identificados por una clave fija. No se crean ni
// se borran desde el panel: solo se edita su valor.
model Texto {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  etiqueta  String
  grupo     String   @default("General")
  valor     String
  multiline Boolean  @default(false)
  // Descripcion breve de que cambia este texto en el sitio, para el panel.
  ayuda     String?
  // Cuando tiene valor, el panel muestra una lista desplegable en vez de un
  // campo libre. Formato: "valor:Etiqueta,valor:Etiqueta".
  opciones  String?
  orden     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Foto de encabezado de cada página. El conjunto de claves es fijo: se editan
// desde el panel pero no se crean ni se borran.
model EncabezadoPagina {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  etiqueta  String
  imagenUrl String
  // Encuadre vertical de la foto dentro de la franja (CSS object-position).
  posicion  String   @default("center")
  orden     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ── RESERVA DE ESPACIOS ──

// Los espacios que el Parque acepta prestar. Es una lista aparte de
// Instalaciones a propósito: hay veintiuna instalaciones pero nadie reserva una
// ciclovía. Qué se presta lo decide el Parque desde el panel.
model EspacioReservable {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String
  // Cuántos hay del mismo tipo (ocho kioscos grandes). Cuál le toca a quién lo
  // asigna el Parque al aprobar; aquí solo se pide "un kiosco grande".
  cantidad     Int?
  capacidad    Int?
  // Si se cobra, se le advierte antes de enviar, no después de aprobarle.
  requierePago Boolean  @default(false)
  activo       Boolean  @default(true)
  orden        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// La lista cerrada de actividades: el filtro que resuelve la preocupación de
// que "cualquiera reserve para lo que quiera". Lo que no está aquí no se puede
// pedir, y las no permitidas se publican para que nadie pierda el viaje.
model TipoActividad {
  id        Int      @id @default(autoincrement())
  nombre    String
  permitido Boolean  @default(true)
  nota      String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Una solicitud, no una reserva. Nada queda apartado hasta que el Parque la
// aprueba; el estado es lo que distingue una cosa de la otra.
model SolicitudReserva {
  id             Int      @id @default(autoincrement())
  nombre         String
  cedula         String
  email          String
  telefono       String
  institucion    String?
  espacio        String
  tipoActividad  String
  // Guardada como "2026-09-14" y no como fecha con hora: el Parque la lee tal
  // cual se escribió, sin que un cambio de zona horaria la corra un día.
  fecha          String
  horaInicio     String
  horaFin        String
  personas       Int
  requerimientos String   @default("")
  descripcion    String
  // pendiente | aprobada | rechazada | cancelada
  estado         String   @default("pendiente")
  motivo         String?
  notaInterna    String?
  emailEnviado   Boolean  @default(false)
  // Si al decidirla se le pudo escribir a quien la pidio. Se guarda aparte del
  // estado: una solicitud puede quedar aprobada y el correo fallar, y entonces
  // hay que verlo en la bandeja en vez de darlo por hecho.
  respuestaEnviada Boolean @default(false)
  respuestaError   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fecha])
}

// Los correos que el sistema manda al decidir una solicitud, editables desde el
// panel. Van en la base y no en el codigo porque el texto es del Parque: cambiar
// como se le habla a la gente no deberia requerir un despliegue.
//
// El conjunto de claves es fijo: se editan, no se crean ni se borran. Si faltara
// la plantilla de una decision, esa decision se quedaria sin correo.
model PlantillaCorreo {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  nombre      String
  descripcion String
  asunto      String
  cuerpo      String
  orden       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ── DONACIONES ──

// Una intención de aportar, no un aporte cobrado. El sitio no cobra nada: la
// persona dice qué quiere dar y el Parque la contacta para coordinarlo. Cuando
// haya pasarela de pago, esto sigue sirviendo igual para lo que no es tarjeta.
model Aporte {
  id          Int      @id @default(autoincrement())
  // dinero | patrocinio | voluntariado
  tipo        String
  nombre      String
  email       String
  telefono    String
  institucion String?
  // Solo para aportes en dinero, y opcional: obligar a poner una cifra antes de
  // hablar con nadie espanta a quien todavía está decidiendo cuánto puede dar.
  monto       Int?
  // unica | mensual
  frecuencia  String?
  mensaje     String
  // pendiente | atendida | descartada
  estado      String   @default("pendiente")
  notaInterna String?
  emailEnviado     Boolean @default(false)
  respuestaEnviada Boolean @default(false)
  respuestaError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado])
}

// Las cuentas donde el Parque puede recibir transferencias. Es una tabla y no
// unos textos sueltos porque puede haber varias: una por banco, o una en pesos
// y otra en dolares. Si no se llega a usar pasarela de pago, esta es la via.
model CuentaBancaria {
  id         Int      @id @default(autoincrement())
  banco      String
  tipoCuenta String
  numero     String
  titular    String
  // Para quien necesite comprobante fiscal. Suele ser el mismo del Patronato,
  // pero se guarda por cuenta por si alguna estuviera a otro nombre.
  rnc        String?
  // DOP | USD
  moneda     String   @default("DOP")
  nota       String?
  activa     Boolean  @default(true)
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
