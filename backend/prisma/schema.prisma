generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Miembros de la Junta Directiva del Patronato (institución, representante, cargo)
model JuntaDirectivo {
  id            Int      @id @default(autoincrement())
  institucion   String
  representante String
  cargo         String
  logoUrl       String?
  fotoUrl       String?
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Personal técnico y administrativo del parque
model PersonalTecnico {
  id        Int      @id @default(autoincrement())
  nombre    String
  cargo     String
  bio       String?
  fotoUrl   String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Instalaciones y áreas del parque (Instalaciones y servicios)
model Instalacion {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  cantidad    Int?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Programas y servicios activos (Programas y proyectos)
model Programa {
  id          Int      @id @default(autoincrement())
  nombre      String
  categoria   String
  descripcion String
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Agenda de eventos (Actividades) — sin datos reales todavía, pendientes del calendario 2026
model Actividad {
  id          Int       @id @default(autoincrement())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime?
  lugar       String?
  imagenUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Puntos señalados en el mapa del parque, con coordenadas geográficas reales
// para ubicarlos sobre el mapa interactivo.
model PuntoMapa {
  id        Int      @id @default(autoincrement())
  nombre    String
  zona      String?
  lat       Float    @default(19.4667)
  lng       Float    @default(-70.6953)
  fotoUrl   String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog: artículos y noticias. Se ordenan por fecha, no por posición manual.
model Publicacion {
  id        Int      @id @default(autoincrement())
  titulo    String
  tipo      String   @default("noticia") // noticia | articulo
  resumen   String?
  contenido String
  imagenUrl String?
  fecha     DateTime @default(now())
  // Cuando está marcada, se anuncia en la barra superior y en la ventana
  // emergente de la página de inicio.
  destacada Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Galería multimedia — pendiente de fotos reales (carpeta FOTOS Y AUDIOVISUALES)
model GaleriaItem {
  id        Int      @id @default(autoincrement())
  titulo    String?
  url       String
  tipo      String   @default("imagen") // imagen | video
  categoria String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Aliados institucionales (logos de las instituciones de la Junta Directiva)
model Aliado {
  id        Int      @id @default(autoincrement())
  nombre    String
  logoUrl   String?
  sitioWeb  String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documentos de Transparencia (estados financieros auditados / sin auditar)
model DocumentoFinanciero {
  id        Int      @id @default(autoincrement())
  titulo    String
  tipo      String // "auditado" | "sin_auditar"
  url       String
  fecha     DateTime?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mensajes del formulario de Contacto y ubicación
model ContactMessage {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String
  telefono     String?
  asunto       String?
  mensaje      String
  emailEnviado Boolean  @default(false)
  createdAt    DateTime @default(now())
}
