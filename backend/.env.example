PORT=4000
NODE_ENV=development

# Postgres — reemplazar con la cadena de conexión real (Railway/Render/Supabase/local)
DATABASE_URL="postgresql://user:password@localhost:5432/parque_central?schema=public"

# SMTP para el formulario de contacto (puede ser Gmail con contraseña de aplicación,
# o cualquier proveedor SMTP transaccional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Parque Central de Santiago <no-reply@parquecentralsantiago.com>"
CONTACT_TO_EMAIL=asistentepcs@gmail.com

# Origen permitido para CORS (el dominio del frontend)
CORS_ORIGIN=http://localhost:5173

# Panel de administración (un solo usuario compartido por el equipo de ULP)
ADMIN_USERNAME=admin
# Generar con: npm run admin:hash-password -- "la-contraseña-elegida"
ADMIN_PASSWORD_HASH=
# Cualquier cadena larga y aleatoria, usada para firmar la sesión de administrador
JWT_SECRET=

# Carpeta donde se guardan las fotos y documentos subidos desde el panel
UPLOADS_DIR=uploads
