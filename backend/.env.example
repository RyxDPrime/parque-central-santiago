PORT=4000
NODE_ENV=development

# Postgres — reemplazar con la cadena de conexión real (Railway/Render/Supabase/local)
DATABASE_URL="postgresql://user:password@localhost:5432/parque_central?schema=public"

# Correo saliente. Se manda por la API HTTPS de Brevo y no por SMTP: el
# servidor donde vive el sitio tiene bloqueada la salida SMTP. Sin la clave, lo
# que llega por los formularios se sigue guardando en el panel, pero nadie
# recibe el aviso por correo.
BREVO_API_KEY=
# El remitente tiene que ser de un dominio verificado en Brevo: con uno sin
# verificar, Brevo rechaza todos los envios.
MAIL_FROM="Parque Central de Santiago <info@parquecentralsantiagord.com>"
# A donde llegan los avisos de los formularios. Admite varias direcciones
# separadas por coma; a todas les llega el mismo aviso.
CONTACT_TO_EMAIL=info@parquecentralsantiagord.com, otra@ejemplo.com

# Direccion publica del sitio. Se usa para armar los enlaces que van dentro de
# un correo -como el de guardar una reserva en el calendario-, donde una ruta
# relativa no lleva a ningun lado. Si falta, se usa CORS_ORIGIN.
SITE_URL=http://localhost:5173

# Origen permitido para CORS (el dominio del frontend). En desarrollo, dejarla
# vacía o sin definir acepta cualquier puerto de localhost.
CORS_ORIGIN=http://localhost:5173

# Firma la sesión del panel: cualquier cadena larga y aleatoria.
JWT_SECRET=

# Carpeta donde se guardan las fotos y documentos subidos desde el panel. En
# Railway tiene que apuntar a un volumen montado; si no, lo subido desaparece
# en el siguiente despliegue.
UPLOADS_DIR=uploads

# Solo para crear la primera cuenta del panel con `node scripts/crear-admin.mjs`.
# El servidor no las usa: el acceso se comprueba contra la tabla de usuarios.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=   # generar con: npm run admin:hash-password -- "la-contraseña"
